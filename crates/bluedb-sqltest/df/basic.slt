# Sanity: writes land via the GlueSQL path; reads come back through the
# DataFusion front door. Exercises a PK point read (fast path), a PK range, and
# read-after-write (UPDATE / DELETE seen by the next analytical read).

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)

statement ok
INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c')

# PK point read — the provider's fast path.
query T
SELECT name FROM t WHERE id = 2
----
b

# PK range + ORDER BY.
query I
SELECT id FROM t WHERE id >= 2 ORDER BY id
----
2
3

query T
SELECT name FROM t ORDER BY id
----
a
b
c

statement ok
UPDATE t SET name = 'z' WHERE id = 1

query T
SELECT name FROM t ORDER BY id
----
z
b
c

statement ok
DELETE FROM t WHERE id = 3

query I
SELECT id FROM t ORDER BY id
----
1
2
