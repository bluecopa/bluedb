# Scalar expressions — CASE / COALESCE / NULLIF / string functions / CAST /
# BETWEEN / IN — through the DataFusion front door.

statement ok
CREATE TABLE e (id INTEGER PRIMARY KEY, a INTEGER, s TEXT)

statement ok
INSERT INTO e VALUES (1, 5, 'hello'), (2, -3, 'World'), (3, 0, 'x')

# CASE.
query IT
SELECT id, CASE WHEN a > 0 THEN 'pos' WHEN a < 0 THEN 'neg' ELSE 'zero' END FROM e ORDER BY id
----
1 pos
2 neg
3 zero

# COALESCE + NULLIF.
query I
SELECT COALESCE(NULLIF(a, 0), -1) FROM e ORDER BY id
----
5
-3
-1

# UPPER.
query IT
SELECT id, UPPER(s) FROM e ORDER BY id
----
1 HELLO
2 WORLD
3 X

# LENGTH.
query II
SELECT id, LENGTH(s) FROM e ORDER BY id
----
1 5
2 5
3 1

# String concatenation operator.
query T
SELECT s || '!' FROM e ORDER BY id
----
hello!
World!
x!

# BETWEEN.
query I
SELECT id FROM e WHERE a BETWEEN -5 AND 5 ORDER BY id
----
1
2
3

# IN list.
query I
SELECT id FROM e WHERE id IN (1, 3) ORDER BY id
----
1
3

# CAST to floating point.
query R
SELECT CAST(a AS DOUBLE) / 2 FROM e ORDER BY id
----
2.5
-1.5
0
